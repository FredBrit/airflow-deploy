# === PostgreSQL ===
POSTGRES_USER=airflow
POSTGRES_PASSWORD=auto_generated
POSTGRES_DB=airflow

# === Airflow Core ===
AIRFLOW__CORE__FERNET_KEY=auto_generated
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=60

# === API / Webserver ===
AIRFLOW__API__SECRET_KEY=auto_generated
AIRFLOW__API__BASE_URL=http://localhost:8080
AIRFLOW__WEBSERVER__SECRET_KEY=auto_generated
AIRFLOW__WEBSERVER__SESSION_COOKIE_DOMAIN=localhost

# === JWT Auth (Airflow 3.x) ===
AIRFLOW__API_AUTH__JWT_SECRET=auto_generated

# === Admin User ===
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=auto_generated

# === Build & Runtime ===
AIRFLOW_IMAGE_NAME=apache/airflow:3.1.8
AIRFLOW_UID=50000
AIRFLOW_GID=0
_PIP_ADDITIONAL_REQUIREMENTS=
